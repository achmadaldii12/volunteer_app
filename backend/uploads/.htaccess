# Folder ini hanya untuk gambar. Matikan eksekusi PHP demi keamanan.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php5|phar)$">
    Require all denied
</FilesMatch>
Options -Indexes
# Izinkan Flutter Web (Chrome) memuat gambar dari alamat lain
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
